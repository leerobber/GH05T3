{
  "agent_id": "GhostRecall",
  "description": "GhostRecall memory subsystem — write_memory across all agent namespaces + audit",
  "allowed_write_classes": ["GHOST_RECALL", "DOME_APPEND"],
  "path_rules": [
    {"prefix": "memory/",         "allow_ghost": true, "comment": "All memory namespaces"},
    {"prefix": "iron_dome_chain", "allow_dome":  true, "comment": "Audit log"}
  ],
  "rate_limits": {
    "GHOST_RECALL": {"max_per_minute": 150},
    "DOME_APPEND":  {"max_per_minute": 200}
  }
}
