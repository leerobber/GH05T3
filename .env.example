# ══════════════════════════════════════════════════════
# GH05T3 v3 — ENVIRONMENT CONFIGURATION
# Copy to .env in your GH05T3 repo root
# ══════════════════════════════════════════════════════

# ── TRI-GPU MESH ────────────────────────────────────────
VLLM_PRIMARY_URL=http://localhost:8010     # RTX 5050 dGPU
LLAMA_VERIFIER_URL=http://localhost:8011   # Radeon 780M
LLAMA_FALLBACK_URL=http://localhost:8012   # Ryzen 7 CPU
GATEWAY_URL=http://localhost:8002          # gateway_v3 (server.py keeps 8001)
GATEWAY_PORT=8002

# ── CLAUDE API ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...              # Get from console.anthropic.com

# ── GITHUB ─────────────────────────────────────────────
GITHUB_PAT=ghp_...                        # Settings → Developer → Personal Access Tokens
GITHUB_REPO=leerobber/GH05T3
GITHUB_BRANCH=main
GITHUB_WEBHOOK_SECRET=your-webhook-secret  # Set in repo Settings → Webhooks
GH05T3_REPO_PATH=/home/terry/GH05T3       # Local clone path on TatorTot

# ── FRONTEND ───────────────────────────────────────────
REACT_APP_GW3_URL=http://localhost:8002    # v3 gateway URL for SwarmBusPanel

# ── SECURITY ───────────────────────────────────────────
KILLSWITCH_KEY_HASH=                       # SHA-256 of your owner key (empty = anyone can trigger)
GH05T3_SECRET=sovereign-ghost-mesh-key-2025
# API token for remote gateway access (Claude Code MCP, peer mesh).
# Auto-generated by install.ps1. If empty, gateway runs in open/dev mode.
GH05T3_API_TOKEN=                          # 32-byte base64 random token

# ── TAILSCALE PEER MESH ────────────────────────────────
# Get your API key from https://login.tailscale.com/admin/settings/keys
TAILSCALE_API_KEY=                         # tskey-api-... (read from tailscale api.txt by install.ps1)
TAILSCALE_TAILNET=-                        # "-" = your default tailnet (or "myorg.github")
TAILSCALE_OWN_IP=                          # Set by install.ps1 to this machine's 100.x.x.x IP
PEER_REFRESH_INTERVAL=300                  # Seconds between peer re-discovery (default 5 min)

# ── MEMORY ─────────────────────────────────────────────
MEMORY_DB_PATH=memory/palace.db
SAGE_ELITE_THRESHOLD=0.90
KAIROS_META_REWRITE_TRIGGER=5

# ── TIA ANDROID ────────────────────────────────────────
TIA_WEBHOOK_SECRET=
TIA_HEARTBEAT_INTERVAL=30

# ── LLM PROVIDER ───────────────────────────────────────
# Controls which model powers Avery.  Cascade: gh05t3 → ollama → groq → anthropic
# Set gh05t3 AFTER running train.bat (adapter must exist at backend/models/gh05t3_lora_adapter/)
LLM_PROVIDER=gh05t3                        # gh05t3 | ollama | groq | google | anthropic

# ── TRAINING OPS ────────────────────────────────────────
# Set to 1 in backend/.env to auto-launch herald + cmd_listener when run.bat starts
ENABLE_OPS=0                               # 1 = auto-start herald + Slack cmd listener

# ── RUNPOD ──────────────────────────────────────────────
RUNPOD_API_KEY=                            # Get from runpod.io/console → Settings → API Keys
HF_TOKEN=hf_...                            # HuggingFace write token (Settings → Access Tokens)
RUNPOD_VOLUME_ID=                          # Optional: attach existing network volume to pods

# ── STRIPE ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...             # Stripe Dashboard → Developers → API keys
STRIPE_WEBHOOK_SECRET=whsec_...           # Stripe Dashboard → Developers → Webhooks

# ── PACT CONTRACT TESTING (PactFlow / broker) ─────────
# Free tier: https://pactflow.io — also set as GitHub secrets PACT_BROKER_URL + PACT_BROKER_TOKEN
PACT_BROKER_BASE_URL=                     # e.g. https://your-org.pactflow.io
PACT_BROKER_TOKEN=                        # PactFlow read/write API token
# Scripts accept either PACT_BROKER_BASE_URL or PACT_BROKER_URL (CI uses the latter name)

# ── AGENT MARKETPLACE ───────────────────────────────────
MARKETPLACE_API_KEY=                      # Secret for POST /marketplace/post + /sentinel/cve-feed; leave empty to disable auth in dev

# ── LEMONADE (AMD Radeon 780M iGPU) ─────────────────────────
# Install: https://github.com/lemonade-sdk/lemonade
# Then: lemonade pull Gemma-4-E2B-it-GGUF
# Lemonade starts as a background service on port 13305 automatically.
LEMONADE_URL=http://localhost:13305       # Chat/STT/TTS/image endpoint
LEMONADE_MODEL=Gemma-4-E2B-it-GGUF      # Default chat model (GGUF via Vulkan/ROCm)
LEMONADE_WHISPER_MODEL=Whisper-Small     # STT model: Whisper-Tiny (fast) or Whisper-Small (accurate)
LEMONADE_IMAGE_MODEL=SDXL-Turbo          # Stable Diffusion model for /avery/image/generate
LEMONADE_TIMEOUT=60                      # Chat request timeout (seconds)
LEMONADE_IMAGE_TIMEOUT=120               # Image generation timeout (seconds)
